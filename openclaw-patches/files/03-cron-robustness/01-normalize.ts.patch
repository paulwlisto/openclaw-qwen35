+/**
+ * Small/mid-size function-calling models (e.g. Qwen3.5 2B) sometimes emit nested
+ * object arguments as JSON-encoded strings instead of real objects — despite the
+ * Qwen template asking for objects. When that happens the downstream schema
+ * validator rejects with `at /payload: must be object` etc.
+ *
+ * Defensively parse any string value that looks like a JSON object/array for the
+ * known nested fields before the rest of normalization runs.
+ */
+const CRON_STRINGIFIED_OBJECT_FIELDS = [
+  "schedule",
+  "payload",
+  "delivery",
+  "patch",
+  "failureAlert",
+] as const;
+
+function parseStringifiedObject(value: unknown): unknown {
+  if (typeof value !== "string") {
+    return value;
+  }
+  const trimmed = value.trim();
+  if (!trimmed || (trimmed[0] !== "{" && trimmed[0] !== "[")) {
+    return value;
+  }
+  try {
+    return JSON.parse(trimmed);
+  } catch {
+    return value;
+  }
+}
+
+function coerceStringifiedObjectFields(record: UnknownRecord): UnknownRecord {
+  for (const key of CRON_STRINGIFIED_OBJECT_FIELDS) {
+    if (key in record) {
+      record[key] = parseStringifiedObject(record[key]);
+    }
+  }
+  return record;
+}
